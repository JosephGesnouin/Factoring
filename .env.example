# =============================================================
# Reconciliation IA — Example environment file
# Copy to .env and fill in your own values.
# =============================================================

# LLM Layer C5 configuration (optional — used for ambiguous cases only)

# Provider: "anthropic" | "openai" | "disabled"
LLM_PROVIDER=anthropic

# Model identifier
#   Anthropic:  claude-opus-4-5 | claude-sonnet-4-5 | claude-haiku-4-5
#   OpenAI:     gpt-4o | gpt-4-turbo | gpt-3.5-turbo
LLM_MODEL=claude-sonnet-4-5

# Your API key (single variable for both providers; takes precedence
# over ANTHROPIC_API_KEY / OPENAI_API_KEY below if set)
LLM_API_KEY=

# Provider-specific fallback keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Custom base URL (proxies, Azure, self-hosted)
LLM_BASE_URL=

# Generation parameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# Kill switch (set to false to bypass the LLM layer entirely)
LLM_ENABLED=true

# Monthly budget cap in USD (calls refused once exceeded)
LLM_MONTHLY_BUDGET=500.0
